
NODE_ENV=development
PORT=8080

# Database — any PostgreSQL instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Auth — generate your own: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# CORS — comma-separated origins allowed to call the API with credentials
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Check-in photo storage — S3-compatible object storage (Cloudflare R2)
# Create a bucket + API token at dash.cloudflare.com → R2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=attendance-photos
S3_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
S3_REGION=auto
UPLOAD_MAX_BYTES=5242880

# Business rules
APP_TIMEZONE=Asia/Jakarta
WORK_START_TIME=09:00

# Set true only behind HTTPS
COOKIE_SECURE=false

# Run the seed automatically on container start
SEED_ON_START=false
